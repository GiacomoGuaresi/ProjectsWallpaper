# Ogni ora al minuto 12, e un minuto dopo l'accesso. La pipeline parte al
# minuto 7 (pg_cron su Supabase) e in un paio di minuti pubblica la foto nuova.
# Persistent: se il PC era spento o in sospensione, il giro perso parte appena possibile.
[Unit]
Description=La Foresta di Projects come sfondo, ogni ora

[Timer]
OnCalendar=*-*-* *:12:00
OnStartupSec=1min
Persistent=true
RandomizedDelaySec=1min

[Install]
WantedBy=timers.target
