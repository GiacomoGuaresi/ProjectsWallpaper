#!/bin/bash
# Aggiorna lo sfondo adesso, senza aspettare il giro orario. Lo installa
# installa.sh in ~/.local/bin. Prima fa rigenerare la foto alla pipeline
# (funzione foresta-aggiorna su Supabase) e aspetta che sia pubblicata, poi fa
# partire il servizio systemd, così il giro è quello di sempre, con il desktop
# salvato in config.env e il log nel journal.
#
#   projectswallpaper          rigenera la foto, la scarica e la mette come sfondo
#   projectswallpaper forza    come sopra, e la rimette anche se non è cambiata
#   projectswallpaper scarica  solo scarica l'ultima foto pubblicata, senza rigenerarla
#   projectswallpaper log      le ultime righe del log

set -euo pipefail

ULTIMA="$HOME/.local/share/projectswallpaper/ultima.png"
FUNZIONE="https://fvsohjlrulwabvfvcfxo.supabase.co/functions/v1/foresta-aggiorna"
INFO="https://giacomoguaresi.github.io/ProjectsWallpaper/info.json"
ATTESA_MASSIMA=300   # secondi: un giro della pipeline, deploy compreso, ne dura un paio

# Il campo "generato" di info.json: cambia a ogni foto nuova.
generato() { curl -fsS --max-time 20 "$INFO" 2>/dev/null | grep -o '"generato": *"[^"]*"' | cut -d'"' -f4; }

# Fa partire la pipeline e aspetta la foto nuova. Se non riesce si scarica comunque l'ultima.
rigenera() {
  local prima risposta stato ora
  prima=$(generato || true)
  if ! risposta=$(curl -fsS --max-time 30 -X POST "$FUNZIONE" 2>&1); then
    echo "non riesco a far partire la pipeline ($risposta): scarico l'ultima foto"
    return
  fi
  stato=$(printf '%s' "$risposta" | grep -o '"stato": *"[^"]*"' | cut -d'"' -f4 || true)
  case "$stato" in
    avviato) echo "pipeline avviata, aspetto la foto nuova…" ;;
    in-corso) echo "pipeline già in corso, aspetto la foto nuova…" ;;
    recente) echo "foto appena rigenerata"; return ;;
    *) echo "risposta inattesa dalla pipeline ($risposta): scarico l'ultima foto"; return ;;
  esac
  for _ in $(seq $((ATTESA_MASSIMA / 5))); do
    sleep 5
    ora=$(generato || true)
    if [ -n "$ora" ] && [ "$ora" != "$prima" ]; then
      echo "foto nuova pubblicata ($ora)"
      return
    fi
  done
  echo "la foto nuova non è arrivata in $((ATTESA_MASSIMA / 60)) minuti: scarico quella che c'è"
}

case "${1:-aggiorna}" in
  aggiorna) rigenera ;;
  forza)
    rigenera
    # Con una data vecchissima il server non può rispondere "non modificata".
    [ -f "$ULTIMA" ] && touch -d @0 "$ULTIMA"
    ;;
  scarica) ;;
  log) journalctl --user -u projectswallpaper -n 20 --no-pager; exit ;;
  *) echo "uso: projectswallpaper [aggiorna|forza|scarica|log]" >&2; exit 2 ;;
esac

inizio=$(date +%s)
# Il servizio è oneshot: start aspetta la fine del giro.
esito=0
systemctl --user start projectswallpaper.service || esito=$?
journalctl --user -u projectswallpaper --since "@$inizio" -o cat --no-pager | grep -v -e '^Start' -e '^Finished' -e 'Consumed' || true
exit "$esito"
