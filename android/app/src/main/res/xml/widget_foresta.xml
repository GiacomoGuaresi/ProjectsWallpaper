<?xml version="1.0" encoding="utf-8"?>
<!--
  Nessun aggiornamento dal sistema (updatePeriodMillis=0): la foto la scarica
  WorkManager ogni ora (AggiornaForesta). 4×3 celle come la foto, 4:3.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_descrizione"
    android:initialLayout="@layout/widget_foresta"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="80dp"
    android:previewImage="@drawable/anteprima"
    android:previewLayout="@layout/anteprima_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
