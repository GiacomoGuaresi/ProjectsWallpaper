<?xml version="1.0" encoding="utf-8"?>
<!--
  La carrellata: la foto, più larga del widget di 2 × @dimen/margine_carrellata,
  scorre avanti e indietro senza fine. ±7% della sua larghezza sta dentro quel
  margine fino a widget larghi ~490dp.
-->
<translate xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="25000"
    android:fromXDelta="-7%"
    android:interpolator="@android:anim/accelerate_decelerate_interpolator"
    android:repeatCount="infinite"
    android:repeatMode="reverse"
    android:toXDelta="7%" />
