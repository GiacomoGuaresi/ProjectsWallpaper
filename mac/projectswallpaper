#!/bin/bash
# Aggiorna lo sfondo adesso, senza aspettare il giro orario. Lo installa
# installa.sh in ~/.local/bin. Fa partire il LaunchAgent, così il giro è quello
# di sempre: stessi permessi su System Events, stesso log.
#
#   projectswallpaper          scarica la foto se è cambiata e la mette come sfondo
#   projectswallpaper forza    la riscarica e la rimette anche se non è cambiata
#   projectswallpaper log      le ultime righe del log

set -euo pipefail

ETICHETTA="it.giacomoguaresi.projectswallpaper"
ULTIMA="$HOME/Library/Application Support/ProjectsWallpaper/ultima.png"
LOG="$HOME/Library/Logs/ProjectsWallpaper.log"

case "${1:-aggiorna}" in
  aggiorna) ;;
  forza)
    # Con una data vecchissima il server non può rispondere "non modificata".
    [ -f "$ULTIMA" ] && touch -t 197001010000 "$ULTIMA"
    ;;
  log) tail -n 20 "$LOG"; exit ;;
  *) echo "uso: projectswallpaper [aggiorna|forza|log]" >&2; exit 2 ;;
esac

if ! launchctl print "gui/$UID/$ETICHETTA" >/dev/null 2>&1; then
  echo "ProjectsWallpaper non è installato: lancia mac/installa.sh" >&2
  exit 1
fi

in_corso() { launchctl print "gui/$UID/$ETICHETTA" | grep -q 'state = running'; }

prima=$(stat -f %z "$LOG" 2>/dev/null || echo 0)
launchctl kickstart "gui/$UID/$ETICHETTA"

# kickstart non aspetta la fine del giro: si aspetta che il log cresca e il job sia finito.
for _ in $(seq 120); do
  sleep 1
  ora=$(stat -f %z "$LOG" 2>/dev/null || echo 0)
  if [ "$ora" -gt "$prima" ] && ! in_corso; then
    tail -c +"$((prima + 1))" "$LOG"
    exit 0
  fi
done
echo "Il giro non è finito entro 2 minuti: guarda $LOG" >&2
exit 1
